import { useState } from "react"; import { Input } from "@/components/ui/input"; import { Button } from "@/components/ui/button"; import { Card, CardContent } from "@/components/ui/card"; import { motion } from "framer-motion";

export default function SahilAIHome() { const [topic, setTopic] = useState(""); const [content, setContent] = useState(null); const [loading, setLoading] = useState(false);

const generateContent = async () => { setLoading(true); const response = await fetch("/api/generate", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ topic }), }); const data = await response.json(); setContent(data); setLoading(false); };

const downloadVoice = () => { const a = document.createElement("a"); a.href = content.voiceUrl; a.download = "sahil_voice_over.mp3"; a.click(); };

return ( <div className="min-h-screen bg-black text-white p-4 flex flex-col items-center"> <h1 className="text-4xl font-bold mb-6">🔥 SahilAI – Reels. Captions. Pehchaan.</h1> <p className="text-lg text-gray-400 mb-4">Enter a topic, get viral-ready content in Hindi-English mix with AI voice!</p>

<div className="flex gap-2 w-full max-w-xl">
    <Input
      placeholder="e.g., Apni Pehchaan Banani Hai"
      value={topic}
      onChange={(e) => setTopic(e.target.value)}
      className="flex-grow bg-zinc-900 border-zinc-700 text-white"
    />
    <Button onClick={generateContent} disabled={loading}>
      {loading ? "Thinking..." : "Generate"}
    </Button>
  </div>

  {content && (
    <motion.div
      className="mt-8 w-full max-w-2xl"
      initial={{ opacity: 0, y: 20 }}
      animate={{ opacity: 1, y: 0 }}
    >
      <Card className="bg-zinc-900 border border-zinc-700">
        <CardContent className="p-4">
          <h2 className="text-xl font-bold mb-2">🎬 Script</h2>
          <p className="mb-4 whitespace-pre-wrap">{content.script}</p>

          <h2 className="text-xl font-bold mb-2">✍ Caption</h2>
          <p className="mb-4 whitespace-pre-wrap">{content.caption}</p>

          <h2 className="text-xl font-bold mb-2">#️⃣ Hashtags</h2>
          <p className="mb-4 whitespace-pre-wrap">{content.hashtags}</p>

          <h2 className="text-xl font-bold mb-2">🎙 Voice-over</h2>
          <audio controls className="w-full mb-2">
            <source src={content.voiceUrl} type="audio/mpeg" />
            Your browser does not support the audio element.
          </audio>
          <Button onClick={downloadVoice}>⬇ Download Voice MP3</Button>
        </CardContent>
      </Card>
    </motion.div>
  )}
</div>

); }

